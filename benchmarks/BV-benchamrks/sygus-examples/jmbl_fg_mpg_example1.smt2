(define-fun plus_7 ((b1 (_ BitVec 32)) (b2 (_ BitVec 32)) (b3 (_ BitVec 32)) (b4 (_ BitVec 32)) (b5 (_ BitVec 32)) (b6 (_ BitVec 32)) (b7 (_ BitVec 32))) (_ BitVec 32)
