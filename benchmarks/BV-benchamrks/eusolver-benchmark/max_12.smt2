(declare-fun max12 ((_ BitVec 32) (_ BitVec 32) (_ BitVec 32) (_ BitVec 32) (_ BitVec 32)
	     	    (_ BitVec 32) (_ BitVec 32) (_ BitVec 32) (_ BitVec 32) (_ BitVec 32)
		    (_ BitVec 32) (_ BitVec 32)) (_ BitVec 32))

(assert (bvuge (max12 x0 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11) x0))
(assert (bvuge (max12 x0 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11) x1))
