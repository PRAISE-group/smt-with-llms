(assert (bvuge (max12 x0 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11) x4))
(assert (bvuge (max12 x0 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11) x5))
(assert (bvuge (max12 x0 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11) x6))
(assert (bvuge (max12 x0 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11) x7))
(assert (bvuge (max12 x0 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11) x8))
(assert (bvuge (max12 x0 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11) x9))
(assert (bvuge (max12 x0 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11) x10))
(assert (bvuge (max12 x0 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11) x11))

(assert
    (or (= (max12 x0 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11) x0)
    (or (= (max12 x0 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11) x1)
    (or (= (max12 x0 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11) x2)
    (or (= (max12 x0 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11) x3)
    (or (= (max12 x0 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11) x4)
    (or (= (max12 x0 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11) x5)
    (or (= (max12 x0 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11) x6)
    (or (= (max12 x0 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11) x7)
    (or (= (max12 x0 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11) x8)
    (or (= (max12 x0 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11) x9)
    (or (= (max12 x0 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11) x10)
        (= (max12 x0 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11) x11)))))))))))))

(check-sat)
(get-value (x0 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11))
(exit)

