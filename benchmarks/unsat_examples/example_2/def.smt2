; Given:
; (declare-fun isprime_cb ((_ BitVec 16)) Bool)
; Spec: Return true iff N is a prime (exact for 16-bit domain).
; Method: N >= 2 and for every prime p <= 251, if N ≠ p then N mod p ≠ 0.
; Logic: QF_BV (uses unsigned compare and bvurem)

(set-logic QF_BV)

(define-fun isprime_cb ((N (_ BitVec 16))) Bool
