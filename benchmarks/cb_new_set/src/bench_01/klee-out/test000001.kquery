array inp_ballot[2] : w32 -> w8 = symbolic
(query [(Eq false
             (Eq 65535
                 N0:(ReadLSB w16 0 inp_ballot)))
         (Eq false (Eq 0 N0))
         (Eq false
             (Eq 0
                 (And w32 N1:(ZExt w32 N0)
                          (ZExt w32 (Extract w16 0 (Add w32 4294967295 N1))))))
         (Eq false
             (Eq (ZExt w32 N2:(Read w8 0 inp_ballot))
                 (ZExt w32 (Extract w8 0 (AShr w32 N1 8)))))]
        false)
