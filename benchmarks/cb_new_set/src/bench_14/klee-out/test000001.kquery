array inp_hi[2] : w32 -> w8 = symbolic
array inp_lo[2] : w32 -> w8 = symbolic
(query [(Eq false
             (Eq (ZExt w32 (ReadLSB w16 0 inp_hi))
                 (ZExt w32 (Or w16 (Shl w16 N0:(ReadLSB w16 0 inp_lo)
                                            8)
                                   (LShr w16 N0 8)))))]
        false)
