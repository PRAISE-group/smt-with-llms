array inp_window[2] : w32 -> w8 = symbolic
(query [(Eq false
             (Eq 0
                 N0:(ReadLSB w16 0 inp_window)))
         (Eq false
             (Eq 0
                 (And w32 N1:(ZExt w32 N0) 65280)))
         (Eq false
             (Eq 0 (And w32 N1 61440)))
         (Eq false
             (Eq 0 (And w32 N1 32768)))]
        false)
