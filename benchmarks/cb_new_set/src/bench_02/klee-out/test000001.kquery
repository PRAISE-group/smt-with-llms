array inp_window[2] : w32 -> w8 = symbolic
(query [(Eq false
             (Eq (ZExt w32 N0:(Extract w8 0 (And w32 N1:(ZExt w32 (ReadLSB w16 0 inp_window))
                                                     255)))
                 (ZExt w32 (Extract w8 0 (AShr w32 N1 8)))))
         (Eq false (Eq 0 N0))]
        false)
