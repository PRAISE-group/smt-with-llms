array inp_value[2] : w32 -> w8 = symbolic
(query [(Ule 10
              N0:(ZExt w32 (ReadLSB w16 0 inp_value)))
         (Ule 10
              N1:(ZExt w32 (Extract w16 0 (UDiv w32 N0 10))))
         (Ule 10
              N2:(ZExt w32 (Extract w16 0 (UDiv w32 N1 10))))
         (Ule 10
              (ZExt w32 (Extract w16 0 (UDiv w32 N2 10))))]
        false)
