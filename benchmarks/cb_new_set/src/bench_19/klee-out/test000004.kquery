array inp_value[2] : w32 -> w8 = symbolic
(query [(Eq false
             (Eq 0
                 N0:(ReadLSB w16 0 inp_value)))
         (Eq false
             (Eq 0
                 N1:(Extract w16 0 (UDiv w32 N2:(ZExt w32 N0) 10))))
         (Eq 0
             (Extract w16 0 (UDiv w32 N3:(ZExt w32 N1) 10)))
         (Eq false
             (Eq (ZExt w32 (Extract w16 0 (Add w32 (Mul w32 10
                                                            (ZExt w32 (Extract w16 0 N4:(URem w32 N2 10))))
                                                   (URem w32 N3 10))))
                 N2))
         (Eq false (Eq 0 N4))]
        false)
