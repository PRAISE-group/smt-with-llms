(set-logic AUFLIA)
(declare-const x Int)
(declare-const y Int)

(declare-fun foo_cb (Int Int) Int)
(declare-fun foo1_cb (Int Int) Int)
(define-fun add ((x Int) (y Int)) Int
  (+ x y)
)
