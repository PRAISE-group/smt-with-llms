array re[12] : w32 -> w8 = symbolic
(query [(Eq false
             (Eq 94 N0:(Read w8 0 re)))
         (Eq false (Eq 0 N0))
         (Eq 42 (Read w8 1 re))
         (Eq 104 (Read w8 2 re))
         (Eq 42 (Read w8 4 re))
         (Eq 0 (Read w8 5 re))
         (Eq 101 N1:(Read w8 3 re))
         (Eq false (Eq 108 N1))
         (Eq false (Eq 46 N1))
         (Or (Eq 104 N0) N2:(Eq 46 N0))
         (Or (Eq 101 N0) N2)]
        false)
