array re[12] : w32 -> w8 = symbolic
(query [(Eq 42 (Read w8 1 re))
         (Eq false
             (Eq 42 N0:(Read w8 3 re)))
         (Eq 104 N1:(Read w8 0 re))
         (Eq 101 (Read w8 2 re))
         (Eq false (Eq 0 N0))
         (Eq 42 (Read w8 4 re))
         (Eq 0 (Read w8 5 re))
         (Eq false (Eq 108 N0))
         (Eq false (Eq 46 N0))
         (Eq false (Eq 101 N1))
         (Eq false (Eq 46 N1))]
        false)
