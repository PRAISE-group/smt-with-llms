array re[12] : w32 -> w8 = symbolic
(query [(Eq 101 (Read w8 0 re))
         (Eq false
             (Eq 42 N0:(Read w8 2 re)))
         (Eq 108 (Read w8 1 re))
         (Eq false (Eq 0 N0))
         (Eq false
             (Eq 42 (Read w8 3 re)))
         (Eq false (Eq 36 N0))
         (Eq false (Eq 46 N0))
         (Eq false (Eq 108 N0))]
        false)
