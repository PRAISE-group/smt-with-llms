array re[12] : w32 -> w8 = symbolic
(query [(Eq 94 (Read w8 0 re))
         (Eq 42 (Read w8 2 re))
         (Eq false
             (Eq 0 N0:(Read w8 3 re)))
         (Eq 42 (Read w8 4 re))
         (Eq 46 (Read w8 5 re))
         (Eq 42 (Read w8 7 re))
         (Eq 0 (Read w8 8 re))
         (Or (Eq 104 N0) N1:(Eq 46 N0))
         (Eq 108 (Read w8 6 re))
         (Or (Eq 101 N0) N1)
         (Eq 104 N2:(Read w8 1 re))
         (Eq false (Eq 101 N2))
         (Eq false (Eq 46 N2))]
        false)
